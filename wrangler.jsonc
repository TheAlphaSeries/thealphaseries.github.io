// Settings Cloudflare uses each time it publishes the site.
{
  "name": "thealphaseries-github-io",
  "main": "scripts/worker.js",
  "compatibility_date": "2026-09-01",
  // Everything in this folder is the website, except what .assetsignore lists.
  "assets": { "directory": ".", "binding": "ASSETS" },
  // The small database that holds petitions to join a quest (see scripts/worker.js).
  "d1_databases": [{ "binding": "QUESTS_DB", "database_name": "halflife-quests", "database_id": "e394b9ce-de5c-42df-b34d-22a1a32dbbf6" }],
  // Email alerts for new entries are sent through Cloudflare's own Email Sending (see scripts/worker.js).
  "send_email": [{ "name": "EMAIL" }],
  // Every 5 minutes the site checks for posts it has not seen before and emails the people who signed up.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Cloudflare's own AI, used to retell quest descriptions in Cugel's manner (see scripts/worker.js, section 9).
  "ai": { "binding": "AI" },
  // Before every publish: rebuild the entry list from posts/, then shrink and rename the site's own code so
  // browsers can keep it (see scripts/build-site.mjs).
  "build": { "command": "node scripts/build-index.mjs && node scripts/build-site.mjs" }
}
